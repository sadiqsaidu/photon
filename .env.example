# Solana JSON-RPC (Helius free tier)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Yellowstone / Geyser gRPC (solinfra.dev, pay-as-you-go)
GRPC_URL=https://your-endpoint.solinfra.dev
GRPC_TOKEN=YOUR_SOLINFRA_TOKEN

# Jito Block Engine (Frankfurt) — used now for tip accounts + leader schedule
JITO_ENGINE=https://frankfurt.mainnet.block-engine.jito.wtf

# Gemini (single model for the agent decision)
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

# Account whose transactions we follow to validate the lifecycle tracker.
# Defaults to a Jito tip account (steady, explorer-verifiable). Higher volume = more GB streamed.
WATCH_ACCOUNT=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5

# Public key only — used by `npm run construct` to build an unsigned bundle. No private key.
WALLET_PUBKEY=

# Optional THROWAWAY secret key for local `npm run submit` / `npm run fault` testing only.
# Never your real wallet. Production signing happens client-side via the dashboard wallet.
WALLET_SECRET=

# Postgres
DATABASE_URL=postgres://photon:photon@localhost:5432/photon

# Tip policy ceiling (lamports)
TIP_CEILING_LAMPORTS=200000
