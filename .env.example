# Solami API key (https://solami.dev/signup?ref=st-earn-sep-26). Needs RPC, gRPC,
# DataApi, MirageView, MirageManage, MirageStream, WebhooksView,
# WebhooksManage and WebhooksStream.
SOLAMI_API_KEY=
# ams (default) | fra | nyc | global (nearest node)
SOLAMI_REGION=ams

# Postgres. Hosted Postgres such as Supabase: append ?sslmode=require
DATABASE_URL=postgres://tipwise:tipwise@localhost:5432/tipwise
PORT=8080

# Optional burner wallet (base58 secret key) that funds probes and `npm run demo`.
PROBE_SECRET=
PROBE_INTERVAL_SEC=60
PROBE_BUDGET_SOL=0.05
# Max probes per process; 0 means until calibrated or out of budget.
PROBE_LIMIT=0

TIP_CEILING_LAMPORTS=1000000
AUDIT_MAX_BLOCKS=40
# Optional public base URL of this server, for HTTP webhook delivery.
WEBHOOK_PUBLIC_URL=

# Bearer token for GET /admin/probe (probe budget and wallet). Unset: the route answers 404.
ADMIN_TOKEN=
# Server-paid test sends per UTC day (they share the probe budget).
DEMO_DAILY_MAX=40
# Comma separated origins allowed by CORS, e.g. https://tipwise.tech,http://localhost:3000. Unset: *.
ALLOWED_ORIGINS=
# Production only (docker-compose.prod.yml): the API hostname Caddy gets a certificate for.
API_DOMAIN=
POSTGRES_PASSWORD=
