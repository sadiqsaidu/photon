# Solana JSON-RPC (Helius free tier works)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Yellowstone / Geyser gRPC (Shyft free tier works)
GRPC_URL=https://grpc.va.shyft.to
GRPC_TOKEN=YOUR_SHYFT_TOKEN

# Jito Block Engine (Frankfurt)
JITO_ENGINE=https://frankfurt.mainnet.block-engine.jito.wtf

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_DEEP=gemini-2.5-pro

# Wallet (base58 secret key or JSON array of bytes)
WALLET_SECRET=

# Guardrails (lamports)
TIP_CEILING_LAMPORTS=200000
BUDGET_LAMPORTS=50000000
