# Solami API key (https://solami.dev/signup?ref=st-earn-sep-26). Needs RPC, gRPC,
# and the DataApi, MirageView, MirageManage, MirageStream, WebhooksView,
# WebhooksManage and WebhooksStream permissions.
SOLAMI_API_KEY=
# Region pin: ams (default) | fra | nyc | global (nearest node).
SOLAMI_REGION=ams

DATABASE_URL=postgres://photon:photon@localhost:5432/photon
PORT=8080

# Optional burner wallet (base58 secret key) that funds live probes and `npm run demo`.
PROBE_SECRET=
PROBE_INTERVAL_SEC=60
PROBE_BUDGET_SOL=0.05

TIP_CEILING_LAMPORTS=5000000
AUDIT_MAX_BLOCKS=40
# Optional public base URL of this server, for HTTP webhook delivery.
WEBHOOK_PUBLIC_URL=
