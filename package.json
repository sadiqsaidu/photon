{
  "name": "photon",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "serve": "tsx --env-file-if-exists=.env src/main.ts serve",
    "doctor": "tsx --env-file-if-exists=.env src/main.ts doctor",
    "demo": "tsx --env-file-if-exists=.env src/main.ts demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "@triton-one/yellowstone-grpc": "4.0.2",
    "bs58": "^6.0.0",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.12",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.4"
  }
}
